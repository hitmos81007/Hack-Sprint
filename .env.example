# Copy to .env at the repository root for local development.
# On Vercel, add these in project Environment Variables; use web/ as Root Directory.
# Public Supabase project URL and anon key (safe only with RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix this or other secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local Hardhat defaults. For Vercel use a reachable Amoy RPC and CHAIN_ID=80002.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY_ADDRESS=
# Local/testnet wallets only. Never use wallets holding real funds.
RELAYER_PRIVATE_KEY=
# Stable server-only random pepper (32+ bytes recommended); changing it changes report hashes.
REGISTRY_PEPPER=
LLM_PROVIDER=mock
LLM_MODEL=
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com
# Provider must be mock | openai | anthropic | gemini. No key needed for mock.
LLM_API_KEY=

# Server-only random secret (16+ characters) for HMAC-hashed rate-limit buckets.
# Set before enabling challenge/verify; never expose through NEXT_PUBLIC_.
RATE_LIMIT_PEPPER=

# Server-only receipt signer, distinct from relayer and institution/officer keys.
VERDICT_SIGNING_KEY=
# Pin its public wallet address for independent receipt verification.
NEXT_PUBLIC_VERDICT_SIGNER_ADDRESS=
OFFICER_REPORT_THRESHOLD=3

# Demo cooling threshold in INR; server enforces the 60-second hold.
UPI_GUARD_THRESHOLD=10000.00
# Optional deployment-controlled Guardian webhook (HTTPS, server-only).
# Empty means persistent in-app demo alerts; no external family message.
GUARDIAN_WEBHOOK_URL=
GUARDIAN_WEBHOOK_SECRET=

# Only accounts at least this old contribute toward a HIGH registry signal (default 1 day).
# Server-only, seconds, 0..31536000. Age is checked against profiles.created_at at lookup time.
REGISTRY_MIN_ACCOUNT_AGE_SECONDS=86400

# Server-only Telegram bot token; never prefix NEXT_PUBLIC_. Optional unless using Telegram Guardians.
TELEGRAM_BOT_TOKEN=

# Local seed CLI only. Use an isolated synthetic project, including a test-only Vercel Production tier. Never real-user production.
DEMO_SEED_ALLOWED=0
# Local seed CLI only. Optional override for the deliberately public demo password.
DEMO_PASSWORD=

# Set to 1 only behind a proxy that overwrites X-Forwarded-For (Vercel is detected).
RATE_LIMIT_TRUST_PROXY=0


